{
  "name": "@interactive-story/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "release:chapter": "npm run build && node dist/scripts/publish-initial-chapter-release.js",
    "seed:story-map": "npm run build && node dist/scripts/seed-chapter-01-story-map.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@interactive-story/api-contracts": "*",
    "@interactive-story/story-core": "*",
    "@prisma/client": "6.12.0",
    "fastify": "^5.0.0",
    "ffprobe-static": "^3.1.0",
    "jose": "^6.2.12",
    "jpeg-js": "^0.4.4"
  }
}
