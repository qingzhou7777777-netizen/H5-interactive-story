# Safe production-shaped template only. Never put real secrets in this file.
NODE_ENV=production

# Public topology.
H5_DOMAIN=bt-ik.top
API_DOMAIN=api.bt-ik.top
ADMIN_DOMAIN=admin.bt-ik.top
MEDIA_DOMAIN=media.bt-ik.top

# Cloudflare Pages public build variables. These values are visible in the browser bundle.
VITE_API_BASE_URL=https://api.bt-ik.top
VITE_AUTH0_DOMAIN=story-production.example.auth0.com
VITE_AUTH0_CLIENT_ID=PUBLIC_AUTH0_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://api.bt-ik.top
VITE_AUTH_CALLBACK_URL=https://bt-ik.top/auth/callback
VITE_AUTH_LOGOUT_URL=https://bt-ik.top

# Admin is built for the protected same-origin gateway.
ADMIN_API_BASE_URL=https://admin.bt-ik.top

# Railway private gateway and Cloudflare Tunnel. TUNNEL_TOKEN is a server secret.
GATEWAY_PORT=8080
API_PRIVATE_ORIGIN=api.railway.internal:3000
CLOUDFLARED_IMAGE=cloudflare/cloudflared:PIN_VERSION_OR_DIGEST_BEFORE_STAGING
TUNNEL_TOKEN=CHANGE_ME_TUNNEL_TOKEN
CLOUDFLARE_ACCESS_TEAM_NAME=USER_CONFIRMATION_REQUIRED
CLOUDFLARE_ACCESS_AUD=USER_CONFIRMATION_REQUIRED

# API runtime.
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGIN=https://bt-ik.top,https://admin.bt-ik.top
TRUST_PROXY=true
LOG_LEVEL=info
API_BODY_LIMIT_BYTES=2097152
API_REQUEST_TIMEOUT_MS=30000
API_SHUTDOWN_TIMEOUT_MS=10000
ANALYTICS_RATE_LIMIT_MAX=120
ANALYTICS_RATE_LIMIT_WINDOW_MS=60000

# Account progress and Auth0 JWT verification.
ACCOUNT_PROGRESS_ENABLED=true
AUTH_ISSUER=https://story-production.example.auth0.com/
AUTH_AUDIENCE=https://api.bt-ik.top
AUTH_JWKS_URL=https://story-production.example.auth0.com/.well-known/jwks.json
AUTH_JWT_ALGORITHMS=RS256

# Railway PostgreSQL database secret.
DATABASE_URL=postgresql://USER:CHANGE_ME@HOST:5432/DB_NAME?schema=public&sslmode=require

# Cloudflare R2. Access and secret keys are server secrets.
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=interactive-story-production
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_R2_SECRET_KEY
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.bt-ik.top
VIDEO_UPLOAD_MAX_BYTES=99614720
FFPROBE_TIMEOUT_MS=30000

# One-time base Seed guard. Do not keep the confirmation enabled after initialization.
BASE_SEED_CONFIRMATION=DO_NOT_SET_UNTIL_AN_APPROVED_EMPTY_DATABASE_INITIALIZATION
SEED_ACTIVE_PAYMENT_OFFER_CODES=USER_CONFIRMATION_REQUIRED
