FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/h5/package.json apps/h5/package.json
COPY packages/api-contracts/package.json packages/api-contracts/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/story-core/package.json packages/story-core/package.json
RUN npm ci

COPY tsconfig.base.json prisma.config.ts ./
COPY apps/api apps/api
COPY packages packages
COPY database database

RUN npm run db:generate \
  && npm run build --workspace @interactive-story/api-contracts \
  && npm run build --workspace @interactive-story/shared \
  && npm run build --workspace @interactive-story/story-core \
  && npm run build --workspace @interactive-story/api

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/api-contracts/package.json ./packages/api-contracts/package.json
COPY --from=build /app/packages/api-contracts/dist ./packages/api-contracts/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/story-core/package.json ./packages/story-core/package.json
COPY --from=build /app/packages/story-core/dist ./packages/story-core/dist
COPY --from=build /app/database/schema.prisma ./database/schema.prisma
COPY --from=build /app/database/migrations ./database/migrations

USER node
EXPOSE 3000
CMD ["node", "apps/api/dist/main.js"]
